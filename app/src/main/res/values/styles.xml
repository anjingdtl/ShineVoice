<resources>
    <!-- Dark-neutral base: the cyberpunk dark theme is primary, so avoid a
         white flash during cold start. In-app Compose colors take over. -->
    <style name="Theme.ShineVoice" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:colorAccent">#FCEE0A</item>
        <item name="android:navigationBarColor">#07090E</item>
        <item name="android:statusBarColor">#07090E</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
